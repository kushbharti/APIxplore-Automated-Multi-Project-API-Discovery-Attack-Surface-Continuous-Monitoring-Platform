# =============================================================================
# Application
# =============================================================================
APP_ENV=development                      # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-256-bit-secret

# =============================================================================
# Security — API key & domain allowlist
# =============================================================================
# If set, every request must include the header: X-API-Key: <value>
# Leave empty for open/unauthenticated mode (internal team tool).
API_KEY=

# Comma-separated list of hostnames allowed as project targets.
# Example: ALLOWED_DOMAINS=myapi.com,api.mycompany.com
# Leave empty to accept any publicly routable URL (open mode).
ALLOWED_DOMAINS=

# =============================================================================
# Database — PostgreSQL (Supabase in production, local Docker in development)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@postgres:5432/apixplore

# For Supabase production:
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=                          # leave empty for local dev, set in production

# =============================================================================
# Monitoring Worker
# =============================================================================
MONITOR_POLL_INTERVAL_SECONDS=10         # how often the worker polls for due checks
MONITOR_LOCK_TTL_SECONDS=30             # distributed lock TTL to prevent duplicate checks

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                          # json | console  (console = human-readable dev format)

# =============================================================================
# CORS
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=100                  # requests per window
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Development / Testing only
# =============================================================================
DEVELOPMENT_MODE=true                    # enables /api/v1/dev/* failure-injection endpoints
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin1234!          # change immediately in any real environment
